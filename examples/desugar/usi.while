(* usi.while - a STATIC-SPINE self-interpreter for WHILE (item 2).                  *)
(*                                                                                  *)
(* Same STEP stack machine as universal.while, but the dispatch is on the CODE      *)
(* stack Cd ALONE (a single-scrutinee `case Cd of`), and the value stack St is      *)
(* read/written directly (hd/tl/cons) inside each arm -- never matched in the case   *)
(* guard.  universal.while uses `case Cd, St of`, whose desugaring CONJOINS the      *)
(* static Cd test with a test on St (dynamic data); under specialization that makes  *)
(* the whole dispatch dynamic, so Cd is dynamicized and the main loop residualizes   *)
(* wholesale (~265 KB even for identity -- see docs/FUTAMURA.md).  Here the guard is  *)
(* purely on Cd (static = the object program), so it folds: the interpreter loop     *)
(* UNROLLS for a straight-line subject (Jones-optimal residual), and only an object  *)
(* program's own while/if (the 'dowh / 'doif markers, which test a dynamic St value) *)
(* residualizes -- exactly the control the residual should keep.                     *)
(*                                                                                  *)
(* Input: (#p# . d) where #p# = DesugarWhile --data-if output; output = [p](d).      *)
(* Cd: code stack,  St: value stack,  Vl: store (indexed by variable number).        *)
read PD;
  Pgm := hd PD;
  D := tl PD;
  I := hd (tl (hd Pgm));             (* input variable number i  *)
  J := hd (tl (hd (tl (tl Pgm))));   (* output variable number j *)
  C := hd (tl Pgm);                  (* program body c           *)

  (* Vl := update I D nil : variable i holds d, others nil *)
  Vl := nil;
  T := nil;
  K := I;
  while K do {
    T := cons (hd Vl) T;
    Vl := tl Vl;
    K := tl K;
  }
  Vl := cons D (tl Vl);
  while T do {
    Vl := cons (hd T) Vl;
    T := tl T;
  }

  Cd := cons C nil;
  St := nil;

  while Cd do {
    case Cd of {

      (* --- expression evaluation (push results onto St) --- *)

      (('quote . (DD . nil)) . Cr) ->
        begin { Cd := Cr; St := cons DD St; } end

      (('var . (KK . nil)) . Cr) ->
        begin {                          (* St := cons (lookup KK Vl) St *)
          Cd := Cr;
          T := Vl;
          K := KK;
          while K do { T := tl T; K := tl K; }
          St := cons (hd T) St;
        } end

      (('hd . (E . nil)) . Cr) ->
        begin { Cd := cons E (cons 'dohd Cr); } end
      ('dohd . Cr) ->
        begin { Cd := Cr; St := cons (hd (hd St)) (tl St); } end

      (('tl . (E . nil)) . Cr) ->
        begin { Cd := cons E (cons 'dotl Cr); } end
      ('dotl . Cr) ->
        begin { Cd := Cr; St := cons (tl (hd St)) (tl St); } end

      (('cons . (E1 . (E2 . nil))) . Cr) ->
        begin { Cd := cons E1 (cons E2 (cons 'docons Cr)); } end
      ('docons . Cr) ->                  (* St = (U . (T1 . Sr)) -> (cons T1 U . Sr) *)
        begin {
          Cd := Cr;
          St := cons (cons (hd (tl St)) (hd St)) (tl (tl St));
        } end

      (('eq . (E1 . (E2 . nil))) . Cr) ->
        begin { Cd := cons E1 (cons E2 (cons 'doeq Cr)); } end
      ('doeq . Cr) ->                    (* St = (U . (T1 . Sr)) -> (=? T1 U . Sr) *)
        begin {
          Cd := Cr;
          St := cons (=? (hd (tl St)) (hd St)) (tl (tl St));
        } end

      (* --- command execution --- *)

      (('semi . (C1 . (C2 . nil))) . Cr) ->
        begin { Cd := cons C1 (cons C2 Cr); } end

      (('asgn . (('var . (KK . nil)) . (E . nil))) . Cr) ->
        begin { Cd := cons E (cons 'doasgn (cons KK Cr)); } end
      ('doasgn . (KK . Cr)) ->           (* Vl := update KK (hd St) Vl ; pop St *)
        begin {
          Cd := Cr;
          T1 := hd St;
          St := tl St;
          T := nil;
          K := KK;
          while K do {
            T := cons (hd Vl) T;
            Vl := tl Vl;
            K := tl K;
          }
          Vl := cons T1 (tl Vl);
          while T do {
            Vl := cons (hd T) Vl;
            T := tl T;
          }
        } end

      (('while . (E . (C1 . nil))) . Cr) ->
        begin {
          WH := cons 'while (cons E (cons C1 nil));
          Cd := cons E (cons 'dowh (cons WH Cr));
        } end
      ('dowh . (WH . Cr)) ->             (* St top = guard value; loop or exit *)
        begin {
          DD := hd St;
          St := tl St;
          if DD then {
            C1 := hd (tl (tl WH));
            Cd := cons C1 (cons WH Cr);
          } else {
            Cd := Cr;
          }
        } end

      (('if . (E . (C1 . (C2 . nil)))) . Cr) ->
        begin { Cd := cons E (cons 'doif (cons C1 (cons C2 Cr))); } end
      ('doif . (C1 . (C2 . Cr))) ->      (* St top = condition value *)
        begin {
          DD := hd St;
          St := tl St;
          if DD then { Cd := cons C1 Cr; } else { Cd := cons C2 Cr; }
        } end
    }
  }

  (* Out := lookup J Vl *)
  T := Vl;
  K := J;
  while K do { T := tl T; K := tl K; }
  Out := hd T;
write Out
