(* spec.while - the ANNOTATION-DRIVEN offline specializer (the self-applicable mix *)
(* of Jones-Sestoft-Sondergaard).  Unlike mix.while (online: it infers binding     *)
(* times by inspecting AV tags at spec time), spec consumes an already-ANNOTATED    *)
(* program ⌜p_ann⌝ (= annotate ⌜p⌝, see src/core/annotate) and dispatches CONTROL   *)
(* on the annotation tags 'asgnS/'asgnD, 'ifS/'ifD, 'whileS/'whileD.  Because the   *)
(* control is then fixed by the (static) program, specializing spec to a known      *)
(* p_ann folds that control away -- the route to SMALL compilers under the Futamura *)
(* projections (Phase D).                                                           *)
(*                                                                                  *)
(* Contract:  [spec]((⌜p_ann⌝ . s)) = ⌜target⌝   with   [target](d) = [p]((s.d)).   *)
(* p reads ONE variable holding (s . d); s static, d dynamic.                       *)
(*                                                                                  *)
(* Annotated value (AV), as in mix.while:                                           *)
(*   ('S . v)            static value v                                             *)
(*   ('D . e)            dynamic; e is residual EXPRESSION code                      *)
(*   ('C . (a1 . a2))    partially-static cons (used for the input (s . d))          *)
(*                                                                                  *)
(* This file currently covers STATIC control (asgnS/asgnD/ifS/semi); D-while and    *)
(* D-if are added incrementally (each a green checkpoint in test-spec.sh).          *)

(* ===================== AV algebra (shared with mix.while) ===================== *)

procedure avhd
read A;
  case A of {
    ('S . V) -> R := cons 'S (hd V);
    ('C . (A1 . A2)) -> R := A1;
    ('D . Ecode) -> R := cons 'D (cons 'hd (cons Ecode nil));
  }
write R

procedure avtl
read A;
  case A of {
    ('S . V) -> R := cons 'S (tl V);
    ('C . (A1 . A2)) -> R := A2;
    ('D . Ecode) -> R := cons 'D (cons 'tl (cons Ecode nil));
  }
write R

(* AV-LIFT: AV -> residual EXPRESSION code recomputing it (explicit stack). *)
procedure avlift
read A;
  Cd := cons A nil;
  St := nil;
  while Cd do {
    case Cd, St of {
      (('S . V) . Cr), SS ->
        begin { Cd := Cr; St := cons (cons 'quote (cons V nil)) SS; } end
      (('D . Ecode) . Cr), SS ->
        begin { Cd := Cr; St := cons Ecode SS; } end
      (('C . (A1 . A2)) . Cr), SS ->
        begin { Cd := cons A1 (cons A2 (cons 'docons Cr)); St := SS; } end
      ('docons . Cr), (R2 . (R1 . Sr)) ->
        begin { Cd := Cr; St := cons (cons 'cons (cons R1 (cons R2 nil))) Sr; } end
    }
  }
  Res := hd St;
write Res

(* AV-EQ: both static -> static bool; otherwise lift and residualize. *)
procedure aveq
read P;
  A1 := hd P;
  A2 := tl P;
  case A1, A2 of {
    ('S . V1), ('S . V2) -> R := cons 'S (=? V1 V2);
    Other1, Other2 -> begin {
        E1 := avlift A1;
        E2 := avlift A2;
        R := cons 'D (cons 'eq (cons E1 (cons E2 nil)));
      } end
  }
write R

(* ===================== AV store ops (shared with mix.while) ===================== *)

procedure lookup
read P;
  Vl := hd P;
  K := tl P;
  T := Vl;
  while K do { T := tl T; K := tl K; }
  if T then { X := hd T; } else { X := cons 'S nil; }
write X

procedure update
read P;
  Vl := hd P;
  K := hd (tl P);
  X := tl (tl P);
  Rev := nil;
  while K do {
    if Vl then { H := hd Vl; Vl := tl Vl; } else { H := cons 'S nil; }
    Rev := cons H Rev;
    K := tl K;
  }
  if Vl then { Vl := tl Vl; }
  Vl := cons X Vl;
  while Rev do { Vl := cons (hd Rev) Vl; Rev := tl Rev; }
write Vl

(* MAKE-SEQ: reversed command list (newest first = runs last) -> one command. *)
procedure makeseq
read Rev;
  if Rev then {
    Acc := hd Rev;
    Rest := tl Rev;
    while Rest do {
      Acc := cons 'semi (cons (hd Rest) (cons Acc nil));
      Rest := tl Rest;
    }
  } else {
    NV := cons 'var (cons (cons nil nil) nil);          (* var 1 *)
    Acc := cons 'asgn (cons NV (cons NV nil));           (* no-op V1 := V1 *)
  }
write Acc

(* ===================== specializer main ===================== *)

read PD;
  Pann := hd PD;                     (* ⌜p_ann⌝ = ((var i) c_ann (var j))   *)
  Sval := tl PD;                     (* static input s                      *)
  I := hd (tl (hd Pann));            (* read variable index  nil^i          *)
  J := hd (tl (hd (tl (tl Pann))));  (* output variable index nil^j         *)
  C := hd (tl Pann);                 (* annotated program body              *)

  (* MKAV: the input is partially static -- ('C . (('S.s) . ('D.(var i)))). *)
  VarI := cons 'var (cons I nil);
  InputAV := cons 'C (cons (cons 'S Sval) (cons 'D VarI));
  Vl := nil;
  Tmp := cons Vl (cons I InputAV);
  Vl := update Tmp;

  RC := nil;                         (* residual command list (reversed)    *)
  Cd := cons C nil;
  St := nil;
  while Cd do {
    case Cd, St of {

      (* ----- expression specialization: tags S/D both push the AV ----- *)

      (('quoteS . (DD . nil)) . Cr), SS ->
        begin { Cd := Cr; St := cons (cons 'S DD) SS; } end

      (('varS . (KK . nil)) . Cr), SS ->
        begin { Cd := Cr; Tmp := cons Vl KK; AvV := lookup Tmp; St := cons AvV SS; } end
      (('varD . (KK . nil)) . Cr), SS ->
        begin { Cd := Cr; Tmp := cons Vl KK; AvV := lookup Tmp; St := cons AvV SS; } end

      (('hdS . (E . nil)) . Cr), SS ->
        begin { Cd := cons E (cons 'dohd Cr); St := SS; } end
      (('hdD . (E . nil)) . Cr), SS ->
        begin { Cd := cons E (cons 'dohd Cr); St := SS; } end
      ('dohd . Cr), (A1 . Sr) ->
        begin { Cd := Cr; Rv := avhd A1; St := cons Rv Sr; } end

      (('tlS . (E . nil)) . Cr), SS ->
        begin { Cd := cons E (cons 'dotl Cr); St := SS; } end
      (('tlD . (E . nil)) . Cr), SS ->
        begin { Cd := cons E (cons 'dotl Cr); St := SS; } end
      ('dotl . Cr), (A1 . Sr) ->
        begin { Cd := Cr; Rv := avtl A1; St := cons Rv Sr; } end

      (('consS . (E1 . (E2 . nil))) . Cr), SS ->
        begin { Cd := cons E1 (cons E2 (cons 'docons Cr)); St := SS; } end
      (('consD . (E1 . (E2 . nil))) . Cr), SS ->
        begin { Cd := cons E1 (cons E2 (cons 'docons Cr)); St := SS; } end
      ('docons . Cr), (A2 . (A1 . Sr)) ->
        begin { Cd := Cr; St := cons (cons 'C (cons A1 A2)) Sr; } end

      (('eqS . (E1 . (E2 . nil))) . Cr), SS ->
        begin { Cd := cons E1 (cons E2 (cons 'doeq Cr)); St := SS; } end
      (('eqD . (E1 . (E2 . nil))) . Cr), SS ->
        begin { Cd := cons E1 (cons E2 (cons 'doeq Cr)); St := SS; } end
      ('doeq . Cr), (A2 . (A1 . Sr)) ->
        begin { Cd := Cr; Tmp := cons A1 A2; Rv := aveq Tmp; St := cons Rv Sr; } end

      (* ----- command specialization (dispatch on the annotation tag) ----- *)

      (('semi . (C1 . (C2 . nil))) . Cr), SS ->
        begin { Cd := cons C1 (cons C2 Cr); St := SS; } end

      (* static assignment: FOLD the (static) value into the slot *)
      (('asgnS . (TGT . (E . nil))) . Cr), SS ->
        begin { KK := hd (tl TGT); Cd := cons E (cons 'dofold (cons KK Cr)); St := SS; } end
      ('dofold . (KK . Cr)), (A1 . Sr) ->
        begin {
          Cd := Cr; St := Sr;
          Tmp := cons Vl (cons KK A1);
          Vl := update Tmp;
        } end

      (* dynamic assignment: MATERIALISE -- emit `(var KK) := lift(A1)` and set the *)
      (* slot to the self-reference ('D.(var KK)) (cf mix.while's emit-on-dyn).      *)
      (('asgnD . (TGT . (E . nil))) . Cr), SS ->
        begin { KK := hd (tl TGT); Cd := cons E (cons 'doemit (cons KK Cr)); St := SS; } end
      ('doemit . (KK . Cr)), (A1 . Sr) ->
        begin {
          Cd := Cr; St := Sr;
          Le := avlift A1;
          VarKK := cons 'var (cons KK nil);
          if =? Le VarKK then { Dummy := nil; } else {
            RC := cons (cons 'asgn (cons VarKK (cons Le nil))) RC;
          }
          SelfAV := cons 'D VarKK;
          Tmp := cons Vl (cons KK SelfAV);
          Vl := update Tmp;
        } end

      (* static conditional: the guard is statically known -> pick a branch *)
      (('ifS . (E . (C1 . (C2 . nil)))) . Cr), SS ->
        begin { Cd := cons E (cons 'doif (cons C1 (cons C2 Cr))); St := SS; } end
      ('doif . (C1 . (C2 . Cr))), (('S . V) . Sr) ->
        begin {
          case V of {
            nil -> begin { Cd := cons C2 Cr; St := Sr; } end
            Other -> begin { Cd := cons C1 Cr; St := Sr; } end
          }
        } end
      ('doif . (C1 . (C2 . Cr))), (('C . PR) . Sr) ->
        begin { Cd := cons C1 Cr; St := Sr; } end

    }
  }

  (* ----- assemble residual: RC ++ [ (var j) := lift Vl[j] ] ----- *)
  Tmp := cons Vl J;
  OutAV := lookup Tmp;
  OutE := avlift OutAV;
  VarJ := cons 'var (cons J nil);
  if =? OutE VarJ then {
    RCfull := RC;
  } else {
    OutAsgn := cons 'asgn (cons VarJ (cons OutE nil));
    RCfull := cons OutAsgn RC;
  }
  BodyAll := makeseq RCfull;
  VarI2 := cons 'var (cons I nil);
  Comp := cons VarI2 (cons BodyAll (cons VarJ nil));
write Comp
